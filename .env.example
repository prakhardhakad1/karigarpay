# Local development starts safely on 127.0.0.1:8000 with an empty database.
KARIGARPAY_ENV=development
KARIGARPAY_SECURE_COOKIES=false
KARIGARPAY_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
KARIGARPAY_HOSTS=localhost,127.0.0.1,[::1]
KARIGARPAY_SESSION_HOURS=12
# Optional absolute paths:
# KARIGARPAY_DB=D:/projects/karigarpay/karigarpay.db
# KARIGARPAY_UPLOADS=D:/projects/karigarpay/private_uploads
# For deployment: use an HTTPS reverse proxy to 127.0.0.1:8000.
# Set ENV=production, SECURE_COOKIES=true, ORIGINS=https://your-domain,
# HOSTS=your-domain,localhost,127.0.0.1. Never expose a PIN app over HTTP.
